---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const siteName = 'Casa Organizada';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="icon" href="data:," />
    <style>
      :root {
        color-scheme: light dark;
        --bg: #fafaf8;
        --fg: #1c1c1a;
        --accent: #2d6a4f;
        --muted: #6b6b63;
        --card: #ffffff;
        --border: #e5e4de;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17181a;
          --fg: #ecece7;
          --accent: #74c69d;
          --muted: #a3a39a;
          --card: #202225;
          --border: #34363a;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding: 1.2rem 1.5rem;
      }
      header a { color: var(--fg); text-decoration: none; font-weight: 700; font-size: 1.2rem; }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
      footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.85rem;
      }
      h1 { font-size: 1.9rem; margin-bottom: 0.3rem; }
      a { color: var(--accent); }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.2rem 1.4rem;
        margin: 1.2rem 0;
      }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        padding: 0.55rem 1.1rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        margin-top: 0.6rem;
      }
      .btn:hover { opacity: 0.9; }
      .meta { color: var(--muted); font-size: 0.85rem; }
      .grid { display: grid; gap: 1rem; }
      .disclosure {
        font-size: 0.8rem;
        color: var(--muted);
        background: var(--card);
        border: 1px solid var(--border);
        padding: 0.6rem 0.9rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">Casa Organizada</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      &copy; {new Date().getFullYear()} Casa Organizada. Como afiliados de Amazon, obtenemos ingresos por las compras que cumplen los requisitos aplicables.
    </footer>
  </body>
</html>
