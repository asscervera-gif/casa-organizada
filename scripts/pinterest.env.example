# Copia este archivo a .env (en la raíz del proyecto) y rellena tu token.
# El archivo .env está en .gitignore: nunca se sube a git ni se comparte en el chat.

# 1. Ve a https://developers.pinterest.com/apps/ y crea una app (gratis).
# 2. En la app, genera un "Access Token" con los scopes: boards:read, boards:write, pins:read, pins:write
#    (Pinterest lo llama "Generate token" dentro del apartado de la app, en modo trial/sandbox al principio).
# 3. Pega el token aquí abajo, sin comillas.
PINTEREST_ACCESS_TOKEN=tu_token_aqui

# Opcional: si ya tienes el ID de un tablero creado, ponlo aquí para reutilizarlo.
# Si lo dejas vacío, el script crea el tablero automáticamente la primera vez
# y te dice qué ID guardar aquí para las siguientes ejecuciones.
PINTEREST_BOARD_ID=

# Opcional: nombre del tablero a crear si no existe todavía.
PINTEREST_BOARD_NAME=Organización del hogar y oficina

# URL real del sitio (ya configurada, no hace falta tocarla salvo que cambie).
SITE_URL=https://casa-organizada.pages.dev
